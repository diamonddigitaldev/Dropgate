<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">

<head>
  <%- include('../partials/head-meta') %>
  <link rel="stylesheet" href="/css/error.css" />

  <script src="/js/theme.js" defer></script>
  <script type="module" src="/js/page-common.js"></script>
</head>

<body>
  <main>
    <div class="container-main text-center">
      <%- include('../partials/header') %>
      <p class="lead mb-4">A lightweight, open-source, privacy-focused file sharing tool.</p>

      <div id="status-card" class="card shadow-sm border-warning">
        <div class="card-body p-4">
          <div id="icon-container" class="mb-3 text-warning">
            <span class="material-icons-round">update</span>
          </div>

          <h5 class="card-title mb-2" id="status-title">Link From an Older Version</h5>
          <p class="card-text text-body-secondary" id="status-message">
            This link was made with an older version of Dropgate, which this server can no longer open.
          </p>
        </div>
      </div>

      <div id="help-statement" class="text-body-secondary mt-4">
        <strong>What do I do now?</strong><br>
        <p>Ask the person who shared it with you to update Dropgate and send the files again.</p>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>

</html>
